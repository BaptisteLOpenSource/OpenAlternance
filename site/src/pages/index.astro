---
import '../styles/tokens.css';
import logo from '../assets/logo.svg';

const github = 'https://github.com/BaptisteLOpenSource/OpenAlternance';
const author = 'https://baptisteledev.fr';
const features = [
	{ title: 'Entreprises & relances', text: 'Note chaque entreprise contactée et ne rate plus aucune relance.' },
	{ title: 'Lettres', text: 'Rédige tes lettres de motivation et garde-les à côté de chaque candidature.' },
	{ title: 'Local ou en ligne', text: 'SQLite sur ta machine, ou Vercel et Neon pour y accéder partout.' },
];
const workflow = [
	{ t: 0, title: 'Connexion', text: 'Un mot de passe, ta base reste chez toi.' },
	{ t: 4, title: 'Dashboard', text: "Entreprises, relances dues et échanges en un coup d'œil." },
	{ t: 10, title: 'Ajouter une entreprise', text: 'Nom, ville, site : la fiche est prête.' },
	{ t: 22, title: 'Ajouter un contact', text: 'La personne à qui écrire, avec son rôle.' },
	{ t: 32, title: 'Noter un échange', text: 'Mail, appel, candidature : la relance est planifiée seule.' },
	{ t: 40, title: 'Lettre de motivation', text: 'Générée depuis ton template, prête à imprimer.' },
	{ t: 44, title: 'Suivre les relances', text: 'La Todo liste ce qui est dû, un clic pour relancer.' },
];
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>OpenAlternance</title>
		<meta name="description" content="Suis tes candidatures en alternance : entreprises, relances, lettres et entretiens." />
		<meta name="color-scheme" content="dark" />
		<link rel="canonical" href="https://openalternance.baptisteledev.fr/" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="OpenAlternance" />
		<meta property="og:description" content="Suis tes candidatures en alternance : entreprises, relances, lettres et entretiens." />
		<meta property="og:url" content="https://openalternance.baptisteledev.fr/" />
		<meta property="og:image" content="https://openalternance.baptisteledev.fr/demo-poster.jpg" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
	</head>
	<body>
		<header class="nav wrap">
			<a class="logo" href="/"><img src={logo.src} alt="" width="28" height="28" />OpenAlternance</a>
			<nav aria-label="Principale">
				<a href="/wiki/">Wiki</a>
				<a href={github}>GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero wrap">
				<div class="hero-text">
					<h1>Tes candidatures en alternance,<br /><span>enfin sous contrôle.</span></h1>
					<p>
						Entreprises, relances, lettres de motivation et entretiens réunis dans une seule app. Lance-la en local
						avec SQLite ou mets-la en ligne avec Vercel et Neon.
					</p>
					<div class="actions">
						<a class="pill pill-light" href="/installation-locale/">Commencer</a>
						<a class="link" href={github}>Voir sur GitHub</a>
					</div>
				</div>

				<figure class="window">
					<div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>openalternance</span></div>
					<button class="window-body" type="button" data-play="0" aria-label="Agrandir la démo">
						<video id="demo" src="/demo.mp4" poster="/demo-poster.jpg" autoplay muted loop playsinline aria-hidden="true"></video>
						<span class="expand" aria-hidden="true">Agrandir ⤢</span>
					</button>
				</figure>
			</section>

			<section class="wrap workflow" aria-labelledby="workflow-title">
				<h2 id="workflow-title">Le parcours, étape par étape</h2>
				<ol>
					{workflow.map((s, i) => (
						<li>
							<button type="button" data-play={s.t}>
								<span class="num">{i + 1}</span>
								<span>
									<strong>{s.title}</strong>
									<span>{s.text}</span>
								</span>
							</button>
						</li>
					))}
				</ol>
			</section>

			<dialog id="player" aria-label="Démo d'OpenAlternance">
				<form method="dialog"><button class="close" aria-label="Fermer">✕</button></form>
				<video src="/demo.mp4" poster="/demo-poster.jpg" controls playsinline preload="none"></video>
			</dialog>

			<section class="wrap features" aria-label="Fonctionnalités">
				{features.map((f) => (
					<article class="feature">
						<h2>{f.title}</h2>
						<p>{f.text}</p>
					</article>
				))}
			</section>

			<section class="wrap">
				<div class="cta-card">
					<h2>Prêt à suivre tes candidatures ?</h2>
					<p>Installe OpenAlternance en quelques minutes, sans compte ni abonnement.</p>
					<a class="pill pill-dark" href="/installation-locale/">Installer</a>
				</div>
			</section>
		</main>

		<footer class="wrap foot">
			<span>OpenAlternance, open source, par <a href={author}>Baptiste Le Dev</a>.</span>
			<a href={github}>GitHub</a>
		</footer>

		<script is:inline>
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const v = document.getElementById('demo');
				v.removeAttribute('autoplay');
				v.pause();
				v.controls = true;
			}
			const player = document.getElementById('player');
			const full = player.querySelector('video');
			document.querySelectorAll('[data-play]').forEach((b) =>
				b.addEventListener('click', (e) => {
					if (e.target.closest('video[controls]')) return;
					player.showModal();
					full.currentTime = Number(b.dataset.play);
					full.play();
				}),
			);
			player.addEventListener('close', () => full.pause());
			player.addEventListener('click', (e) => e.target === player && player.close());
		</script>
	</body>
</html>

<style>
	:global(*, *::before, *::after) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		font-family: var(--oa-font);
		color: var(--oa-text);
		background: var(--oa-grain), var(--oa-glow), var(--oa-bg);
		background-attachment: fixed;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	:global(:focus-visible) {
		outline: 2px solid var(--oa-violet-soft);
		outline-offset: 3px;
		border-radius: 999px;
	}

	a {
		color: inherit;
	}

	.wrap {
		width: min(72rem, 100% - 2.5rem);
		margin-inline: auto;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.5rem;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.9rem;
	}

	nav a {
		color: var(--oa-muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--oa-text);
	}

	.hero {
		display: grid;
		gap: 3rem;
		align-items: center;
		padding-block: 3rem 5rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 6vw, 4rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
		font-weight: 700;
	}

	h1 span {
		color: var(--oa-muted);
	}

	.hero-text p {
		max-width: 32rem;
		margin: 1.5rem 0 2rem;
		color: var(--oa-muted);
		font-size: 1.075rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
	}

	.pill {
		display: inline-block;
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: transform 0.2s;
	}

	.pill:hover {
		transform: translateY(-1px);
	}

	.pill-light {
		background: var(--oa-text);
		color: var(--oa-bg);
	}

	.pill-dark {
		background: var(--oa-bg);
		color: var(--oa-text);
	}

	.link {
		font-weight: 500;
		color: var(--oa-muted);
		text-underline-offset: 4px;
	}

	.link:hover {
		color: var(--oa-text);
	}

	.window {
		margin: 0;
		border: 1px solid var(--oa-line);
		border-radius: var(--oa-radius-lg);
		background: var(--oa-surface);
		padding: 0.5rem;
		box-shadow: 0 30px 80px -20px rgb(124 58 237 / 0.35);
	}

	.window-bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0.75rem 0.75rem;
	}

	.window-bar i {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--oa-line);
	}

	.window-bar span {
		margin-inline: auto;
		padding: 0.15rem 1rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.05);
		color: var(--oa-muted);
		font-size: 0.75rem;
	}

	.window-body {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		cursor: zoom-in;
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: calc(var(--oa-radius-lg) - 0.5rem);
		background: var(--oa-grain), radial-gradient(circle at 30% 20%, #6d28d9, transparent 60%),
			radial-gradient(circle at 80% 90%, #312e81, transparent 55%), #0d0b14;
	}

	video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.expand {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		font: 500 0.8rem var(--oa-font);
		opacity: 0;
		transition: opacity 0.2s;
	}

	.window-body:hover .expand,
	.window-body:focus-visible .expand {
		opacity: 1;
	}

	.workflow {
		padding-bottom: 4rem;
	}

	.workflow h2 {
		margin: 0 0 1.5rem;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		letter-spacing: -0.03em;
	}

	.workflow ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.workflow button {
		display: flex;
		gap: 1rem;
		width: 100%;
		height: 100%;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--oa-line);
		border-radius: var(--oa-radius);
		background: rgb(255 255 255 / 0.025);
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: border-color 0.2s;
	}

	.workflow button:hover {
		border-color: var(--oa-violet-soft);
	}

	.workflow strong {
		display: block;
	}

	.workflow button span span {
		color: var(--oa-muted);
		font-size: 0.9rem;
	}

	.num {
		flex: none;
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 50%;
		background: var(--oa-violet-soft);
		color: #fff;
		font-weight: 600;
		font-size: 0.85rem;
	}

	dialog {
		width: min(96vw, 110rem);
		padding: 0;
		border: 1px solid var(--oa-line);
		border-radius: var(--oa-radius-lg);
		background: #000;
		overflow: hidden;
	}

	dialog::backdrop {
		background: rgb(0 0 0 / 0.8);
		backdrop-filter: blur(4px);
	}

	dialog video {
		display: block;
		position: static;
		width: 100%;
		height: auto;
		max-height: 90vh;
	}

	.close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 1;
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		font-size: 1rem;
		cursor: pointer;
	}

	.features {
		display: grid;
		gap: 1rem;
		padding-bottom: 4rem;
	}

	.feature {
		padding: 1.5rem;
		border: 1px solid var(--oa-line);
		border-radius: var(--oa-radius);
		background: rgb(255 255 255 / 0.025);
	}

	.feature h2 {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.feature p {
		margin: 0;
		color: var(--oa-muted);
		font-size: 0.95rem;
	}

	.cta-card {
		padding: clamp(2.5rem, 8vw, 5rem) clamp(1.5rem, 6vw, 4rem);
		border-radius: var(--oa-radius-lg);
		background: var(--oa-grain), radial-gradient(circle at 15% 0%, #8b5cf6, transparent 55%),
			radial-gradient(circle at 100% 100%, #3b0764, transparent 60%), #6d28d9;
		text-align: center;
	}

	.cta-card h2 {
		margin: 0;
		font-size: clamp(1.75rem, 5vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.cta-card p {
		margin: 1rem auto 2rem;
		max-width: 28rem;
		color: #f3f0ff;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 3rem;
		color: var(--oa-muted);
		font-size: 0.875rem;
	}

	@media (min-width: 48rem) {
		.features {
			grid-template-columns: repeat(3, 1fr);
		}

		.workflow ol {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: 1fr 1.15fr;
			padding-block: 5rem 7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pill {
			transition: none;
		}
	}
</style>
